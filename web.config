<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <clear />
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath=".\runtime\node.exe" arguments="server.cjs" startupTimeLimit="60" startupRetryCount="2" stdoutLogEnabled="true" stdoutLogFile=".\runtime\startup.log">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="HOST" value="127.0.0.1" />
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="SQL_TRUSTED_CONNECTION" value="false" />
        <environmentVariable name="SQL_CREATE_DATABASE" value="false" />
        <environmentVariable name="DEMO_AUTH_ENABLED" value="false" />
        <environmentVariable name="MOCK_PAYMENTS_ENABLED" value="false" />
      </environmentVariables>
    </httpPlatform>
    <httpErrors existingResponse="PassThrough" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="runtime" /><add segment="runtime" />
          <remove segment=".local" /><add segment=".local" />
          <remove segment=".env" /><add segment=".env" />
          <remove segment="node_modules" /><add segment="node_modules" />
          <remove segment="server" /><add segment="server" />
          <remove segment="scripts" /><add segment="scripts" />
          <remove segment="database" /><add segment="database" />
          <remove segment=".git" /><add segment=".git" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
