{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "steps": {
    "install": {
      "commands": [
        {
          "path": "/app/node_modules/.bin"
        },
        {
          "cmd": "mkdir -p /app/node_modules/.cache"
        },
        {
          "dest": "package-lock.json",
          "src": "package-lock.json"
        },
        {
          "dest": "package.json",
          "src": "package.json"
        },
        "npm ci --include=dev --include=optional --prefer-offline"
      ]
    },
    "build": {
      "commands": [
        "...",
        "npm run build:windows-runtime"
      ]
    }
  },
  "deploy": {
    "startCommand": "npm start",
    "variables": {
      "NODE_ENV": "production",
      "HOST": "0.0.0.0",
      "SQL_TRUSTED_CONNECTION": "false",
      "SQL_CREATE_DATABASE": "false",
      "DEMO_AUTH_ENABLED": "false",
      "MOCK_PAYMENTS_ENABLED": "false"
    },
    "inputs": [
      "...",
      {
        "step": "build",
        "include": [
          "/app/runtime"
        ]
      }
    ]
  }
}
