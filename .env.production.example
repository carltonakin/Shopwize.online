# SmarterASP.NET Windows IIS runtime, built with Railpack on Linux.
# Set actual values privately in the website application-pool environment.
# This file is an example and is NOT automatically loaded by the application.
NODE_ENV=production
HOST=127.0.0.1
# web.config maps PORT to HTTP_PLATFORM_PORT. Do not set a fixed port in IIS.
# PORT=3000
PUBLIC_ORIGIN=https://shopwize.online
CHECKOUT_ORIGIN=https://shopwize.online
DEMO_AUTH_ENABLED=false
MOCK_PAYMENTS_ENABLED=false
SQL_TRUSTED_CONNECTION=false
SQL_CREATE_DATABASE=false
# Use the SQL Server details assigned to your SmarterASP.NET account.
SQL_SERVER=your-provider-sql-hostname
SQL_PORT=1433
SQL_DATABASE=your-provider-database-name
SQL_USER=your-provider-sql-login
SQL_PASSWORD=
SQL_ENCRYPT=true
SQL_TRUST_CERTIFICATE=false
MARKETPLACE_CURRENCY=USD
LIVE_POLICY_CONFIRMED=false
TAX_CONFIGURATION_CONFIRMED=false
LIVE_INTEGRATION_VERIFIED=false
# Configure payment, country, tax, SMTP, and DNS variables from .env.example as needed.
