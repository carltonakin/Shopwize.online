NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:5173
SQL_SERVER=localhost
SQL_DATABASE=ShopwizeDev
SQL_TRUSTED_CONNECTION=true
SQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server
SQL_ENCRYPT=false
SQL_TRUST_CERTIFICATE=true
SQL_USER=
SQL_PASSWORD=
DEMO_AUTH_ENABLED=true
MOCK_PAYMENTS_ENABLED=true
MARKETPLACE_CURRENCY=USD
OPERATING_COUNTRY=
SELLER_COUNTRIES=
COMMISSION_BPS=1000
LIVE_POLICY_CONFIRMED=false
TAX_RATE_BPS=0
TAX_CONFIGURATION_CONFIRMED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_MODEL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PARTNER_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CHECKOUT_ORIGIN=http://localhost:5173

LIVE_INTEGRATION_VERIFIED=false
PAYPAL_FEE_REFUNDS_ENABLED=false
PAYPAL_BN_CODE=
STRIPE_SUBSCRIPTION_PRICE_ID=
BASE_DOMAIN=
SHOPWIZE_EDGE_CNAME=

# Initial administrator (only for an empty production database; supply via secure environment)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional TCP port (blank preserves local instance discovery)
SQL_PORT=
# Leave unset for automatic local DB creation; production defaults to false.
# Set false when using an existing provider-managed database.
# SQL_CREATE_DATABASE=false
